<Page
    x:Class="UtilityMaster.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="#0f1116" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" Width="520" Margin="40">
            <TextBlock Text="Utility Master" FontSize="28" FontWeight="Bold" Foreground="#f5a623"
                HorizontalAlignment="Center" Margin="0,30,0,8"/>
            <TextBlock x:Name="SubtitleText" Text="CS2 Tactics Tool" FontSize="14" Foreground="#888"
                HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <TextBlock x:Name="LinksTitle" Text="Links" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
            <TextBlock Foreground="#3b82f6" FontSize="13" Cursor="Hand" Margin="0,0,0,4"
                MouseLeftButtonDown="OpenUrl" Tag="https://github.com/primspark/UtilityMaster/issues">
                GitHub Issues</TextBlock>
            <TextBlock Foreground="#3b82f6" FontSize="13" Cursor="Hand" Margin="0,0,0,4"
                MouseLeftButtonDown="OpenUrl" Tag="https://space.bilibili.com/558194430">
                Bilibili</TextBlock>
            <TextBlock Foreground="#3b82f6" FontSize="13" Cursor="Hand" Margin="0,0,0,16"
                MouseLeftButtonDown="OpenUrl" Tag="mailto:primspark@outlook.com">
                primspark@outlook.com</TextBlock>

            <TextBlock x:Name="LicenseTitle" Text="License" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
            <TextBlock x:Name="LicenseText" Text="MIT License - Open Source" Foreground="#aaa" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <TextBlock x:Name="DisclaimersTitle" Text="Disclaimers" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
            <TextBlock x:Name="Disclaimer1" Text="" Foreground="#888" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock x:Name="Disclaimer2" Text="" Foreground="#888" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock x:Name="Disclaimer3" Text="" Foreground="#888" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock x:Name="Disclaimer4" Text="" Foreground="#888" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <TextBlock x:Name="CreditsTitle" Text="Credits" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
            <TextBlock x:Name="Credit1" Foreground="#888" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap">
                <Run x:Name="Credit1Prefix" Text="Map icons &amp; minimap images from "/><Hyperlink Foreground="#3b82f6" NavigateUri="https://github.com/MurkyYT/cs2-map-icons" RequestNavigate="Hyperlink_RequestNavigate">MurkyYT/cs2-map-icons</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="Credit2" Foreground="#888" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap">
                <Run x:Name="Credit2Prefix" Text="Nade icons from "/><Hyperlink Foreground="#3b82f6" NavigateUri="https://liquipedia.net/" RequestNavigate="Hyperlink_RequestNavigate">Liquipedia</Hyperlink>
            </TextBlock>

            <TextBlock x:Name="VersionText" Text="v1.0.0" Foreground="#555" FontSize="11" HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</Page>
