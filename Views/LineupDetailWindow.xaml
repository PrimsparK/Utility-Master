<Window
    x:Class="UtilityMaster.Views.LineupDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="Lineup Detail" Width="860" Height="960"
    MinWidth="520" MinHeight="600"
    WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
    Background="#1a1d24">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Variant navigation -->
            <StackPanel x:Name="VariantNav" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
                <Button x:Name="VariantPrevBtn" Content="◀ Prev" Height="28"
                        Background="#2a2d34" Foreground="#f5a623" BorderThickness="0" FontSize="11"
                        Cursor="Hand" Margin="0,0,6,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="VariantLabel" Text="1/1" Foreground="#666" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="VariantNextBtn" Content="Next ▶" Height="28"
                        Background="#2a2d34" Foreground="#f5a623" BorderThickness="0" FontSize="11"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleLabel" Text="Lineup Detail" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Border Background="#2a2d34" CornerRadius="6" Padding="10,4">
                        <TextBlock x:Name="SideInfoText" Text="T smoke" FontSize="12" Foreground="#ccc" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="#0f1116" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TargetTitle" Text="" Foreground="#f5a623" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TargetNameText" Text="" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CoordText" Text="" Foreground="#888" FontSize="12"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="AimDescTitle" Text="Aim Description" Foreground="#f5a623" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
            <Border Background="#0f1116" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                <TextBlock x:Name="AimDescText" Foreground="#ccc" FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock x:Name="ThrowTypeTitle" Text="Throw Type:" Foreground="#f5a623" FontSize="13" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBlock x:Name="ThrowTypeText" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- IMAGES SECTION -->
            <StackPanel x:Name="ImagesSection" Visibility="Collapsed">
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Images" Foreground="#f5a623" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="ImageCountText" Text="" Foreground="#666" FontSize="11" Margin="8,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Background="#0a0b0e" CornerRadius="8" MinHeight="260" Margin="0,0,0,8" Padding="4">
                    <Image x:Name="PrimaryImage" Stretch="Uniform" StretchDirection="DownOnly"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                    <StackPanel x:Name="ThumbnailPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </StackPanel>

            <!-- VIDEO SECTION -->
            <StackPanel x:Name="VideoSection" Visibility="Collapsed">
                <TextBlock x:Name="VideoTitle" Text="Video" Foreground="#f5a623" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                <!-- Local video player -->
                <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                    MinHeight="360" Margin="0,0,0,4" Visibility="Collapsed"/>
                <!-- WebView2 for YouTube/Bilibili -->
                <Border Background="#000000" CornerRadius="8" ClipToBounds="True"
                    x:Name="WebViewContainer" Height="420" Visibility="Collapsed" Margin="0,0,0,4">
                    <wpf:WebView2 x:Name="VideoWebView"/>
                </Border>
                <!-- Video controls for local -->
                <StackPanel x:Name="VideoControls" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,8">
                    <Button Content="Play" Width="56" Height="28" Background="#f5a623" Foreground="#0f1116" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="VideoPlay_Click" Margin="0,0,8,0"/>
                    <Button Content="Pause" Width="56" Height="28" Background="#2a2d34" Foreground="#ccc" BorderThickness="0" FontSize="12" Click="VideoPause_Click" Margin="0,0,8,0"/>
                    <Button Content="Stop" Width="56" Height="28" Background="#2a2d34" Foreground="#ccc" BorderThickness="0" FontSize="12" Click="VideoStop_Click"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="NotesTitle" Text="Notes" Foreground="#f5a623" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
            <Border Background="#0f1116" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <TextBlock x:Name="NotesText" Foreground="#ccc" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
