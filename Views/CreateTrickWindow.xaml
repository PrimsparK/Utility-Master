<Window
    x:Class="UtilityMaster.Views.CreateTrickWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create Spot" Width="420" Height="620"
    WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="400" MinWidth="380"
    WindowStyle="None" AllowsTransparency="True"
    Background="Transparent">
    <Border Background="#1a1d24" CornerRadius="12" BorderBrush="#2a2d34" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <Grid Margin="0,0,0,14">
                    <TextBlock x:Name="WinTitle" Text="Create Spot" FontSize="18" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button Content="&#x2715;" Width="28" Height="28" FontSize="14"
                            Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Right" Click="CloseBtn_Click"/>
                </Grid>

                <TextBlock x:Name="NameLabel" Text="Name" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                <Border Background="#0f1116" CornerRadius="6" Height="34" Margin="0,0,0,12">
                    <TextBox x:Name="NameBox" Background="Transparent" Foreground="White" BorderThickness="0"
                             VerticalAlignment="Center" FontSize="13" Padding="10,0"/>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TypeLabel" Text="Type" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                        <Border Background="#0f1116" CornerRadius="6" Height="34">
                            <ComboBox x:Name="TypeBox" Background="Transparent" Foreground="White" BorderThickness="0"
                                      VerticalAlignment="Center" FontSize="13" Padding="6,0" SelectedIndex="0"
                                      >
                                <ComboBoxItem x:Name="CbWallbang" Content="Wallbang" Tag="wallbang"/>
                                <ComboBoxItem x:Name="CbBoost" Content="Boost" Tag="boost"/>
                                <ComboBoxItem x:Name="CbJump" Content="Jump" Tag="jump"/>
                                <ComboBoxItem x:Name="CbCamp" Content="Camp" Tag="camp"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="SideLabel" Text="Side" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                        <Border Background="#0f1116" CornerRadius="6" Height="34">
                            <ComboBox x:Name="SideBox" Background="Transparent" Foreground="White" BorderThickness="0"
                                      VerticalAlignment="Center" FontSize="13" Padding="6,0" SelectedIndex="2">
                                <ComboBoxItem x:Name="CbT" Content="T" Tag="T"/>
                                <ComboBoxItem x:Name="CbCT" Content="CT" Tag="CT"/>
                                <ComboBoxItem x:Name="CbBoth" Content="Both" Tag="Both"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="XLabel" Text="Position X" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                <Border Background="#0f1116" CornerRadius="6" Height="34" Margin="0,0,0,8">
                    <TextBox x:Name="XBox" Background="Transparent" Foreground="White" BorderThickness="0"
                             VerticalAlignment="Center" FontSize="13" Padding="10,0"/>
                </Border>

                <TextBlock x:Name="YLabel" Text="Position Y" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                <Border Background="#0f1116" CornerRadius="6" Height="34" Margin="0,0,0,16">
                    <TextBox x:Name="YBox" Background="Transparent" Foreground="White" BorderThickness="0"
                             VerticalAlignment="Center" FontSize="13" Padding="10,0"/>
                </Border>

                <!-- Boost/Camp extra fields (hidden for Wallbang/Jump) -->
                <StackPanel x:Name="ExtraFields" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="ImagesLabel" Text="Images" FontSize="12" Foreground="#999" VerticalAlignment="Bottom"/>
                        <Button x:Name="PasteBtn" Content="Paste (Ctrl+V)" Width="110" Height="28"
                                Background="#2a2d34" Foreground="#ccc" BorderThickness="0" FontSize="11"
                                HorizontalAlignment="Right" Cursor="Hand" Click="Paste_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter Margin="10,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <ItemsControl x:Name="ImageList" Margin="0,4,0,12" MinHeight="36">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock x:Name="VideoLabel" Text="Video URL" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                    <Border Background="#0f1116" CornerRadius="6" Height="34" Margin="0,0,0,12">
                        <TextBox x:Name="VideoBox" Background="Transparent" Foreground="White" BorderThickness="0"
                                 VerticalAlignment="Center" FontSize="13" Padding="10,0"/>
                    </Border>

                    <TextBlock x:Name="NotesLabel" Text="Notes" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                    <Border Background="#0f1116" CornerRadius="6" Margin="0,0,0,16">
                        <TextBox x:Name="NotesBox" Background="Transparent" Foreground="White" BorderThickness="0"
                                 Height="54" TextWrapping="Wrap" Padding="10,6" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>

                <Button x:Name="CreateBtn" Content="Create" Background="#f5a623" Foreground="#0f1116" FontWeight="Bold" FontSize="13"
                        Click="Create_Click" Height="38" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="ErrorLabel" Foreground="#ef4444" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
