<Page
    x:Class="UtilityMaster.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="#0f1116" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" MaxWidth="600">
            <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>

            <TextBlock x:Name="DefaultFiltersHeader" Text="Default Filters" FontSize="16" FontWeight="Bold" Foreground="#f5a623" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblDefType" Text="Default Type" Foreground="#999" VerticalAlignment="Center"/>
                <ComboBox x:Name="DefType" Grid.Column="1" Background="#1a1d24" Foreground="White" Height="30" BorderThickness="0">
                    <ComboBoxItem x:Name="DefTypeSmoke" Content="Smoke" Tag="smoke"/><ComboBoxItem x:Name="DefTypeFlash" Content="Flash" Tag="flash"/>
                    <ComboBoxItem x:Name="DefTypeMolotov" Content="Molotov" Tag="molotov"/><ComboBoxItem x:Name="DefTypeHE" Content="HE" Tag="he"/>
                </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblDefSide" Text="Default Side" Foreground="#999" VerticalAlignment="Center"/>
                <ComboBox x:Name="DefSide" Grid.Column="1" Background="#1a1d24" Foreground="White" Height="30" BorderThickness="0">
                    <ComboBoxItem Content="T" Tag="T"/><ComboBoxItem Content="CT" Tag="CT"/><ComboBoxItem Content="T+CT" Tag="Both"/>
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblDefTrickType" Text="Def. Trick Type" Foreground="#999" VerticalAlignment="Center"/>
                <ComboBox x:Name="DefTrickType" Grid.Column="1" Background="#1a1d24" Foreground="White" Height="30" BorderThickness="0">
                    <ComboBoxItem x:Name="DefTrickWallbang" Content="Wallbang" Tag="wallbang"/>
                    <ComboBoxItem x:Name="DefTrickBoost" Content="Boost" Tag="boost"/>
                    <ComboBoxItem x:Name="DefTrickJump" Content="Jump" Tag="jump"/>
                    <ComboBoxItem x:Name="DefTrickCamp" Content="Camp" Tag="camp"/>
                </ComboBox>
            </Grid>

            <TextBlock x:Name="ConflictHeader" Text="Conflict Distance Thresholds" FontSize="16" FontWeight="Bold" Foreground="#f5a623" Margin="0,12,0,8"/>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblNadesT" Text="Nades Target (px)" Foreground="#999" VerticalAlignment="Center"/>
                <TextBox x:Name="T_NadesTarget" Grid.Column="1" Background="#1a1d24" Foreground="White" Height="28" BorderThickness="0" Padding="8,0"/></Grid>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblNadesL" Text="Nades Lineup (px)" Foreground="#999" VerticalAlignment="Center"/>
                <TextBox x:Name="T_NadesLineup" Grid.Column="1" Background="#1a1d24" Foreground="White" Height="28" BorderThickness="0" Padding="8,0"/></Grid>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblWbT" Text="Wallbang Target (px)" Foreground="#999" VerticalAlignment="Center"/>
                <TextBox x:Name="T_WallbangTarget" Grid.Column="1" Background="#1a1d24" Foreground="White" Height="28" BorderThickness="0" Padding="8,0"/></Grid>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblWbL" Text="Wallbang Lineup (px)" Foreground="#999" VerticalAlignment="Center"/>
                <TextBox x:Name="T_WallbangLineup" Grid.Column="1" Background="#1a1d24" Foreground="White" Height="28" BorderThickness="0" Padding="8,0"/></Grid>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblTrickT" Text="Tricks Target (px)" Foreground="#999" VerticalAlignment="Center"/>
                <TextBox x:Name="T_TrickTarget" Grid.Column="1" Background="#1a1d24" Foreground="White" Height="28" BorderThickness="0" Padding="8,0"/></Grid>

            <TextBlock x:Name="DisplayHeader" Text="Display" FontSize="16" FontWeight="Bold" Foreground="#f5a623" Margin="0,12,0,8"/>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblAutoPlay" Text="Auto-play video" Foreground="#999" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkAutoPlay" Grid.Column="1" Foreground="White"/></Grid>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblLang" Text="Language" Foreground="#999" VerticalAlignment="Center"/>
                <ComboBox x:Name="LangCombo" Grid.Column="1" Background="#1a1d24" Foreground="White" Height="28">
                    <ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="中文" Tag="zh"/></ComboBox></Grid>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblChineseTerms" Text="Chinese terms" Foreground="#999" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkChineseTerms" Grid.Column="1" Foreground="White"/></Grid>

            <TextBlock x:Name="LblDataPathHeader" Text="Data Storage" FontSize="16" FontWeight="Bold" Foreground="#f5a623" Margin="0,16,0,8"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DataPath" Background="#1a1d24" Foreground="White" Height="30" BorderThickness="0"
                         VerticalAlignment="Center" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Browse..." Background="#2a2d34" Foreground="White"
                        BorderThickness="0" Height="30" Width="70" Cursor="Hand"
                        Margin="8,0,0,0" Click="BrowseDataPath_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#3a3d44" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>            <TextBlock x:Name="SecurityHeader" Text="Security" FontSize="16" FontWeight="Bold" Foreground="#f5a623" Margin="0,12,0,8"/>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LblAllowDelete" Text="Allow delete default spots" Foreground="#999" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkAllowDelete" Grid.Column="1" Foreground="White"/></Grid>



            <Button x:Name="SaveBtn" Margin="0,16,0,0" Content="Save Settings" Click="SaveBtn_Click"
                Background="#f5a623" Foreground="#0f1116" FontWeight="Bold" Height="36" Width="160"/>
            <TextBlock x:Name="StatusText" Foreground="#4ade80" FontSize="12" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
