<Window
    x:Class="UtilityMaster.Views.AimPointDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Aim Point" Width="420" Height="360"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
    WindowStyle="None" AllowsTransparency="True"
    Background="Transparent">
    <Border Background="#1a1d24" CornerRadius="12" BorderBrush="#2a2d34" BorderThickness="1">
        <StackPanel Margin="20">
            <TextBlock Text="Add Aim Point" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
            
            <TextBlock Text="Aim Image" Foreground="#999" FontSize="12" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,8">
                <TextBox x:Name="ImagePathBox" Background="#0f1116" Foreground="White" BorderThickness="0"
                         Height="30" VerticalAlignment="Center" FontSize="12" Padding="8,0"/>
                <Button Content="Paste" Width="60" Height="24" Background="#2a2d34" Foreground="#ccc"
                        BorderThickness="0" FontSize="10" HorizontalAlignment="Right" Margin="0,0,4,0"
                        Cursor="Hand" Click="PasteBtn_Click"/>
            </Grid>
            
            <TextBlock Text="Description" Foreground="#999" FontSize="12" Margin="0,0,0,4"/>
            <Border Background="#0f1116" CornerRadius="6" Margin="0,0,0,14">
                <TextBox x:Name="DescBox" Background="Transparent" Foreground="White" BorderThickness="0"
                         Height="60" TextWrapping="Wrap" Padding="8,6" VerticalScrollBarVisibility="Auto"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Height="32" Background="#2a2d34" Foreground="#ccc"
                        BorderThickness="0" FontSize="12" Cursor="Hand" Click="CancelBtn_Click" Margin="0,0,8,0"/>
                <Button Content="OK" Width="80" Height="32" Background="#f5a623" Foreground="#0f1116"
                        BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="OkBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
