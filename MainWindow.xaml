<Window
    x:Class="UtilityMaster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Utility Master"
    Width="1400" Height="960" Background="#0f1116">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left nav bar -->
        <Border Grid.Column="0" Background="#0a0c10" Width="48">
            <Border.Resources>
                <Style TargetType="Border" x:Key="NavBtn">
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="Width" Value="36"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Margin" Value="0,4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </Border.Resources>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border x:Name="NNav" Style="{StaticResource NavBtn}" Background="#f5a623"
                    MouseLeftButtonDown="NadesNav_Click"
                    ToolTip="Nades (Ctrl+N)">
                    <TextBlock Text="⌺" FontSize="20" FontWeight="Bold" Foreground="#0f1116"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="TNav" Style="{StaticResource NavBtn}" Background="#1a1d24"
                    MouseLeftButtonDown="TricksNav_Click"
                    ToolTip="Tricks">
                    <TextBlock Text="⊞" FontSize="18" FontWeight="Bold" Foreground="#888"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Rectangle Height="1" Width="24" Fill="#2a2d34" Margin="0,8"/>
                <Border Style="{StaticResource NavBtn}"
                    MouseLeftButtonDown="SettingsNav_Click"
                    ToolTip="Settings">
                    <TextBlock Text="⚙" FontSize="18" Foreground="#666"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource NavBtn}"
                    MouseLeftButtonDown="AboutNav_Click"
                    ToolTip="About">
                    <TextBlock Text="ⓘ" FontSize="18" Foreground="#666"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Column="1"/>
    </Grid>
</Window>
